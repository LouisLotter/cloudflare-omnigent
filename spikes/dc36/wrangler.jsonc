// DC-36 staging check for the WP0.4 follow-up. A Worker with one tiny container: deploy,
// redeploy (no new image expected), tear down, then redeploy (a new image must be pushed, and the
// container application created), then tear down again. Nothing runs in the container.
//
//   pnpm stg deploy --suffix dc36 --owner wp0.4f --config spikes/dc36/wrangler.jsonc --days 1
//   pnpm stg teardown --suffix dc36
{
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "cfo-stg-dc36",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "Probe" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Probe"] }],
  "containers": [
    {
      "name": "cfo-stg-dc36-probe",
      "class_name": "Probe",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "observability": { "enabled": true }
}
