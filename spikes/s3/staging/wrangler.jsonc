// Spike S3 staging run: the capture measurements only real Cloudflare Containers can answer
// (disk, filesystem, cgroupfs, capabilities, the pause with Omnigent's processes stopped),
// the bytes each Claude Code and Codex turn changes, and DirectoryBackup to R2 (layers, a
// base-plus-20-deltas restore, R2 held for more than 90 s). One standard-2 container, no
// internet: the Omnigent server and the mock LLM run inside it, beside the supervisor.
// Prepared and dry-run only; the owner runbook is in the S3 staging evidence.
//
//   python3 spikes/s3/bench/prepare_staging.py && npm ci --prefix spikes/s3/staging
//   pnpm stg deploy --suffix s3-capture --owner S3 --config spikes/s3/staging/wrangler.jsonc --days 1
//   (owner, in a browser) https://<hostname>/ -> "Start the staging campaign"
//   pnpm stg teardown --suffix s3-capture   (also empties and deletes the bucket)
//
// nodejs_compat: @cloudflare/sandbox imports node:os.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "cfo-stg-s3-capture",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": true }
  },
  "durable_objects": { "bindings": [{ "name": "BENCH", "class_name": "Bench" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bench"] }],
  "r2_buckets": [{ "binding": "CKPT", "bucket_name": "cfo-stg-s3-capture-ckpt" }],
  "containers": [
    {
      "name": "cfo-stg-s3-capture-box",
      "class_name": "Bench",
      "image": "../image/Dockerfile",
      "image_build_context": "../image",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ]
}
