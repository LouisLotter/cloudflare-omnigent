// Spike S1: lifecycle and wake time. Deploy only with the guarded staging tool:
//
//   pnpm stg deploy --suffix s1-life --owner S1 --config spikes/s1/wrangler.jsonc --days 2
//   pnpm stg teardown --suffix s1-life
//
// After the first deploy, one owner-authenticated GET /s1/kickoff starts the alarm loop.
// Later phases are queued by redeploying with a new S1_COMMAND (see src/index.js).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cfo-stg-s1-life",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": true }
  },
  "vars": {
    "S1_VERSION": "1",
    "S1_REARM": "1",
    "S1_COMMAND": "c1:server-up,wake=21,heartbeat,no-heartbeat,eviction,eviction-control"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SERVER", "class_name": "S1Server" },
      { "name": "COMPUTER", "class_name": "S1Computer" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["S1Server", "S1Computer"] }],
  "containers": [
    {
      "name": "cfo-stg-s1-life-server",
      "class_name": "S1Server",
      "image": "./server/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    },
    {
      "name": "cfo-stg-s1-life-computer",
      "class_name": "S1Computer",
      "image": "./computer/Dockerfile",
      "max_instances": 1,
      "instance_type": "standard-2"
    }
  ]
}
