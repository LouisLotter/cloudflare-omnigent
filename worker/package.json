{
  "name": "@cfo/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc -p . && tsc -p test",
    "test": "pnpm test:unit && pnpm test:workers",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:workers": "vitest run -c vitest.workers.config.ts",
    "coverage": "pnpm coverage:unit && pnpm coverage:workers",
    "coverage:unit": "vitest run -c vitest.unit.config.ts --coverage",
    "coverage:workers": "vitest run -c vitest.workers.config.ts --coverage",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "journeys": "node test/e2e/journeys.ts"
  },
  "dependencies": {
    "@cfo/contracts": "workspace:*",
    "@cloudflare/sandbox": "1.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@vitest/coverage-istanbul": "5.0.3",
    "fast-check": "4.10.2",
    "playwright-core": "1.64.1",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
