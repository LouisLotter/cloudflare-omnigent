{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Local journeys only (WP3.5, journeys.ts): the production web Worker behind a seeding route.
  // Never deployed. Ingress's variables come from journeys.ts, with a local keys stand-in.
  "name": "cloudflare-omnigent-web-e2e",
  "main": "web-e2e.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "OMNIGENT", "class_name": "OmnigentServer", "script_name": "cloudflare-omnigent" },
      { "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "cloudflare-omnigent" },
      { "name": "CONTROL", "class_name": "ControlDO", "script_name": "cloudflare-omnigent" }
    ]
  },
  "services": [{ "binding": "E2E", "service": "cloudflare-omnigent" }],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/xterm.js", "**/xterm.css", "**/addon-fit.js", "**/setup-client.js"],
      "fallthrough": false
    }
  ]
}
