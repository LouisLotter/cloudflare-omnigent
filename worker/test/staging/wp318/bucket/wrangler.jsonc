{
  "$schema": "../../../../../node_modules/wrangler/config-schema.json",
  // The M3 sitting (WP3.18's soak and WP3.5's checks): holds the installation's R2 buckets, the
  // replica's and Omnigent's artifacts' (G2-DUR-001), so that they exist before the owner makes
  // one token for both (the platform Worker binds only its own checkpoint and results buckets;
  // Litestream and Omnigent reach R2 over S3). The Worker answers 404 to everything. Deploy only
  // with run.sh:
  //   pnpm stg deploy --suffix wp318-r2 --owner WP3.18 --config <this file> --days 2
  "name": "cfo-stg-wp318-r2",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "r2_buckets": [
    { "binding": "REPLICA", "bucket_name": "cfo-stg-wp318-r2-db" },
    { "binding": "ARTIFACTS", "bucket_name": "cfo-stg-wp318-r2-artifacts" }
  ]
}
