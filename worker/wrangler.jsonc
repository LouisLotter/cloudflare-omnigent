{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The platform Worker (AR-17): every Durable Object and container class, the private virtual
  // hosts, and no public route. The web Worker (wrangler.web.jsonc) binds its classes by this
  // name, so deploy this one first. Deployed names come from scripts/deploy.ts, which enforces
  // the cfo-stg- prefix for staging.
  //
  // OmnigentServer's container entry joins once the server image exists (WP2.3):
  //   "containers": [{ "class_name": "OmnigentServer", "image": "../images/server/Dockerfile",
  //                    "image_build_context": "..", "instance_type": "basic", "max_instances": 1 }]
  // Until then the class has no container and answers 503; Wrangler refuses a Dockerfile path
  // that does not exist, in a dry run too.
  "name": "cloudflare-omnigent",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Closed by default: no route of its own, no workers.dev or preview URL.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlDO" },
      { "name": "OMNIGENT", "class_name": "OmnigentServer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControlDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OmnigentServer"] }
  ],
  "observability": { "enabled": true }
}
