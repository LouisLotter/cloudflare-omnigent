{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The web Worker (AR-17): the public hostname, ingress, the forwarding path to Omnigent and
  // the platform pages. No Durable Object class, no container, no migration: it reaches
  // the platform Worker's objects through cross-script bindings to "cloudflare-omnigent"
  // (wrangler.jsonc), so its deploys never drop a computer's connection. Deploy it after the
  // platform Worker. The installation (WP2.4) adds the custom domain and ingress's variables.
  "name": "cloudflare-omnigent-web",
  "main": "src/web.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "OMNIGENT", "class_name": "OmnigentServer", "script_name": "cloudflare-omnigent" },
      // The platform pages (WP3.5): each computer's WorkspaceDO, through its narrow pages
      // interface and the terminal's upgrade only, and ControlDO's list of computers.
      { "name": "WORKSPACE", "class_name": "WorkspaceDO", "script_name": "cloudflare-omnigent" },
      { "name": "CONTROL", "class_name": "ControlDO", "script_name": "cloudflare-omnigent" }
    ]
  },
  // The platform pages' assets, bundled as text modules (WP3.5, src/pages/assets.ts): xterm.js and
  // its fit add-on, pinned in package.json, and the setup page's own script.
  "rules": [
    {
      "type": "Text",
      "globs": ["**/xterm.js", "**/xterm.css", "**/addon-fit.js", "**/setup-client.js"],
      "fallthrough": false
    }
  ],
  // Structured console logs on; invocation logs off. An invocation log records every request
  // header: Cloudflare redacts Cookie and the Access assertion but not custom headers, such as
  // Omnigent's X-Omnigent-Host-Token or x-api-key (WP2.6, docs/secrets.md).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
