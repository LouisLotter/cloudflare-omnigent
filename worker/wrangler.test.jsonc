{
  "$schema": "node_modules/wrangler/config-schema.json",
  // For the Workers-runtime tests only (vitest.workers.config.ts): the platform Worker's classes
  // with no containers, from a test entry that simulates the containers and the clocks
  // (test/support/platform-test-worker.ts). Keep the bindings and migrations in step with
  // wrangler.jsonc.
  "name": "cloudflare-omnigent-test",
  "main": "test/support/platform-test-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL", "class_name": "ControlDO" },
      { "name": "OMNIGENT", "class_name": "OmnigentServer" },
      // WORKSPACE is the assembled WorkspaceDO (WP3.18), which the routes, the backup gateway
      // and ControlDO reach: only its runtime container and clock are simulated
      // (test/support/assembly-harness.ts). WP3.1's controller under fakes is tested on
      // WORKSPACE_CONTROLLER (test/support/workspace-harness.ts).
      { "name": "WORKSPACE", "class_name": "WorkspaceDO" },
      { "name": "WORKSPACE_CONTROLLER", "class_name": "WorkspaceUnderFakes" }
    ]
  },
  // The computers' checkpoint bucket (local R2): WorkspaceDO's reads and deletes, and the fenced
  // backup gateway's writes (egress/backups.ts).
  "r2_buckets": [{ "binding": "CHECKPOINTS", "bucket_name": "cfo-test-checkpoints" }],
  // Synthetic values only (canaries), as an installation would set them.
  "vars": {
    "CFO_INSTALLATION_ID": "ins_01hs3f9q2m8z4w7k6t5r1n0ybc",
    "SERVER_ENV_OMNIGENT_ACCOUNTS_INIT_ADMIN_USERNAME": "owner-canary",
    "SERVER_ENV_OMNIGENT_ACCOUNTS_INIT_ADMIN_PASSWORD": "cfo-canary-bootstrap-password",
    "ACCESS_AUD": "cfo-canary-access-aud",
    // The launcher API's signing keys (WP3.3): the server's own, and a previous one in rotation.
    "SERVER_ENV_CFO_LAUNCHER_SIGNING_KEY_ID": "k-test-current",
    "SERVER_ENV_CFO_LAUNCHER_SIGNING_KEY": "cfo-canary-launcher-key-current-0000000000",
    "CFO_LAUNCHER_SIGNING_KEY_PREVIOUS_ID": "k-test-previous",
    "CFO_LAUNCHER_SIGNING_KEY_PREVIOUS": "cfo-canary-launcher-key-previous-000000000"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControlDO"] },
    { "tag": "v2", "new_sqlite_classes": ["OmnigentServer"] },
    { "tag": "v3", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v4", "new_sqlite_classes": ["WorkspaceUnderFakes"] }
  ]
}
