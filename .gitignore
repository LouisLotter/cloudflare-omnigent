# Secrets and local configuration
.env
.env.*
.dev.vars
.dev.vars.*
!.dev.vars.example

# Node and Wrangler
node_modules/
.wrangler/
dist/
coverage/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
*.egg-info/

# Editors and OS
.idea/
.vscode/
.DS_Store

# Agent worktrees created by Claude Code
.claude/worktrees/

# Local staging state: account, owner email and resource registry (never committed)
.staging/
# Wrangler configurations the staging tool renders next to a checked one for one deploy
.stg-rendered.*.jsonc
# Wrangler configurations the bootstrap script renders for one installation's deploy
.cfo-bootstrap.*.jsonc

# Process documents: reviews (including the Codex active review), plans, the tracker and
# evidence live outside this repository and are never committed. These are the paths the
# reviewers and older tools write to inside a checkout.
docs/ACTIVE_REVIEW*.md
docs/WORKPLAN.md
docs/verification/
docs/reviews/
spikes/*/reviews/
