{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "emails": {
      "items": {
        "maxLength": 320,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "owners": {
      "items": {
        "maxLength": 320,
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "revision",
    "emails",
    "owners"
  ],
  "title": "AccessAdmissionCall",
  "type": "object"
}
