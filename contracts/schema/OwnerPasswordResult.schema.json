{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "state",
          "type": "string"
        },
        "intentToken": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "state": {
          "enum": [
            "unchosen",
            "chosen"
          ],
          "type": "string"
        },
        "username": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action",
        "state",
        "username",
        "intentToken"
      ],
      "type": "object"
    },
    {
      "oneOf": [
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "set",
              "type": "string"
            },
            "outcome": {
              "const": "done",
              "type": "string"
            }
          },
          "required": [
            "action",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "set",
              "type": "string"
            },
            "outcome": {
              "const": "unconfirmed",
              "type": "string"
            }
          },
          "required": [
            "action",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "set",
              "type": "string"
            },
            "outcome": {
              "const": "unavailable",
              "type": "string"
            },
            "retryAfterSeconds": {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "action",
            "outcome",
            "retryAfterSeconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "set",
              "type": "string"
            },
            "outcome": {
              "const": "refused",
              "type": "string"
            },
            "reason": {
              "enum": [
                "intent",
                "rate_limited",
                "not_configured"
              ],
              "type": "string"
            },
            "retryAfterSeconds": {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "action",
            "outcome",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "set",
              "type": "string"
            },
            "outcome": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "action",
            "outcome"
          ],
          "type": "object"
        }
      ]
    }
  ],
  "title": "OwnerPasswordResult"
}
