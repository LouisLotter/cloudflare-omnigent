{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "member",
          "type": "string"
        },
        "memberId": {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "admin",
            "member"
          ],
          "type": "string"
        },
        "state": {
          "enum": [
            "invited",
            "active",
            "suspended",
            "removed"
          ],
          "type": "string"
        },
        "userId": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action",
        "memberId",
        "userId",
        "role",
        "state"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "none",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "unsupported",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "unavailable",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    }
  ],
  "title": "PagePersonResult"
}
