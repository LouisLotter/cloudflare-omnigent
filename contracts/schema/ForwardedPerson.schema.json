{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "email": {
      "maxLength": 320,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "type": "string"
    },
    "expiresAt": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "installationOwner": {
      "type": "boolean"
    },
    "issuer": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    },
    "subject": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "issuer",
    "subject",
    "audience",
    "installationOwner",
    "expiresAt"
  ],
  "title": "ForwardedPerson",
  "type": "object"
}
