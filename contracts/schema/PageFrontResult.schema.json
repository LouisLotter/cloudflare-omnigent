{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "oneOf": [
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "open_terminal",
              "type": "string"
            },
            "capability": {
              "pattern": "^[A-Za-z0-9_-]{43}$",
              "type": "string"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "outcome": {
              "const": "accepted",
              "type": "string"
            },
            "presentBy": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "until": {
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "type": "string"
            },
            "window": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "action",
            "outcome",
            "capability",
            "window",
            "generation",
            "until",
            "presentBy"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "open_terminal",
              "type": "string"
            },
            "outcome": {
              "const": "refused",
              "type": "string"
            },
            "reason": {
              "enum": [
                "not_running",
                "busy",
                "not_offered",
                "window_closed"
              ],
              "type": "string"
            }
          },
          "required": [
            "action",
            "outcome",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "close_terminal",
          "type": "string"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "closed"
      ],
      "type": "object"
    },
    {
      "oneOf": [
        {
          "additionalProperties": {},
          "properties": {
            "action": {
