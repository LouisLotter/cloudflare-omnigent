          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "renewed"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "operation": {
          "const": "status",
          "type": "string"
        },
