              "type": "string"
            }
          },
          "required": [
            "operation",
            "admitting",
            "status",
            "generation"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "admitting": {
              "const": false,
              "type": "boolean"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "message": {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            "operation": {
              "const": "admission",
              "type": "string"
            },
            "reason": {
              "enum": [
                "not_saved",
                "needs_sign_in"
              ],
              "type": "string"
            },
            "status": {
              "enum": [
                "stopped",
                "started_no_host",
                "start_claimed",
                "host_running",
                "host_refused",
                "stopping"
              ],
              "type": "string"
            }
          },
          "required": [
            "operation",
            "admitting",
            "reason",
            "status",
            "generation"
          ],
          "type": "object"
        }
      ]
    },
    {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "folded": {
              "type": "boolean"
