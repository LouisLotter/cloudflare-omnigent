    {
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "pattern": "^cmp_[0-9a-hjkmnp-tv-z]{26}$",
          "type": "string"
        },
        "operation": {
          "const": "provision",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "computerId"
      ],
      "type": "object"
    },
    {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "granted": {
              "const": true,
