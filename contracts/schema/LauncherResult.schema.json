          "type": "string"
        }
      },
      "required": [
        "operation",
        "running",
        "status",
        "generation"
      ],
      "type": "object"
    },
    {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "admitting": {
              "const": true,
              "type": "boolean"
            },
            "generation": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "operation": {
              "const": "admission",
              "type": "string"
            },
            "status": {
              "enum": [
                "stopped",
                "started_no_host",
                "start_claimed",
                "host_running",
                "host_refused",
                "stopping"
