            },
            "operation": {
              "const": "claim_start",
              "type": "string"
            },
            "startAttempt": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "operation",
            "granted",
            "startAttempt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "granted": {
              "const": false,
