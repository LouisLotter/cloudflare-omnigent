        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "suspend",
              "type": "string"
            },
            "outcome": {
              "const": "stopped",
              "type": "string"
            }
          },
          "required": [
            "operation",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "suspend",
              "type": "string"
            },
            "outcome": {
              "const": "in_progress",
              "type": "string"
            }
          },
          "required": [
            "operation",
            "outcome"
          ],
          "type": "object"
