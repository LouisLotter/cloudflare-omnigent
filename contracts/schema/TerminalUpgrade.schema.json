{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
    "capability": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "computerId": {
      "pattern": "^cmp_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "interfaceVersion": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "owner": {
      "additionalProperties": {},
      "properties": {
        "admission": {
          "enum": [
            "owner",
            "members"
          ],
          "type": "string"
        },
        "audience": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "issuer": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "person": {
          "oneOf": [
            {
              "additionalProperties": {},
              "properties": {
                "kind": {
                  "const": "installation_owner",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "additionalProperties": {},
              "properties": {
                "kind": {
                  "const": "member",
                  "type": "string"
                },
                "memberId": {
                  "pattern": "^[0-9a-f]{32}$",
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "owner",
                    "admin",
                    "member"
                  ],
                  "type": "string"
                },
                "userId": {
                  "maxLength": 255,
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "memberId",
                "userId",
                "role"
              ],
              "type": "object"
            }
          ]
        },
        "sessionId": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sub": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "sub",
        "sessionId"
      ],
      "type": "object"
    }
  },
  "required": [
    "interfaceVersion",
    "computerId",
    "owner",
    "capability"
  ],
  "title": "TerminalUpgrade",
  "type": "object"
}
