{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "applied",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "outcome",
        "revision"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "appliedRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outcome": {
          "const": "stale",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "appliedRevision"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "refused",
          "type": "string"
        },
        "reason": {
          "enum": [
            "not_configured",
            "owner_missing",
            "foreign_rules",
            "group_missing"
          ],
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "reason"
      ],
      "type": "object"
    }
  ],
  "title": "AccessAdmissionResult"
}
