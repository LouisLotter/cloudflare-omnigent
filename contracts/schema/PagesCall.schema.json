{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "state",
          "type": "string"
        },
        "interfaceVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "owner": {
          "additionalProperties": {},
          "properties": {
            "admission": {
              "enum": [
                "owner",
                "members"
              ],
              "type": "string"
            },
            "audience": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            },
            "issuer": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "person": {
              "oneOf": [
                {
                  "additionalProperties": {},
                  "properties": {
                    "kind": {
                      "const": "installation_owner",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": {},
                  "properties": {
                    "kind": {
                      "const": "member",
                      "type": "string"
                    },
                    "memberId": {
                      "pattern": "^[0-9a-f]{32}$",
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "owner",
                        "admin",
                        "member"
                      ],
                      "type": "string"
                    },
                    "userId": {
                      "maxLength": 255,
                      "minLength": 1,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "memberId",
                    "userId",
                    "role"
                  ],
                  "type": "object"
                }
              ]
            },
            "sessionId": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "sub": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "sub",
            "sessionId"
          ],
          "type": "object"
        }
      },
      "required": [
        "action",
        "interfaceVersion"
      ],
      "type": "object"
    },
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "set_size",
          "type": "string"
        },
        "interfaceVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "operationId": {
          "pattern": "^op_[0-9a-hjkmnp-tv-z]{26}$",
          "type": "string"
        },
        "size": {
          "enum": [
            "lite",
            "basic",
            "standard-1",
            "standard-2",
            "standard-3",
            "standard-4"
          ],
          "type": "string"
        }
      },
      "required": [
        "action",
        "interfaceVersion",
        "operationId",
        "size"
      ],
      "type": "object"
    },
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "restart",
          "type": "string"
        },
        "interfaceVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "operationId": {
          "pattern": "^op_[0-9a-hjkmnp-tv-z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "action",
        "interfaceVersion",
        "operationId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "stop_without_saving",
          "type": "string"
        },
        "interfaceVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "operationId": {
          "pattern": "^op_[0-9a-hjkmnp-tv-z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "action",
        "interfaceVersion",
        "operationId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": {},
      "properties": {
        "action": {
          "const": "sign_out",
          "type": "string"
        },
        "interfaceVersion": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        "operationId": {
          "pattern": "^op_[0-9a-hjkmnp-tv-z]{26}$",
          "type": "string"
        }
      },
      "required": [
        "action",
        "interfaceVersion",
        "operationId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": {},
      "properties": {
