{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "computerId": {
      "pattern": "^cmp_[0-9a-hjkmnp-tv-z]{26}$",
      "type": "string"
    },
    "generation": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "hostId": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "propsVersion": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "propsVersion",
    "computerId",
    "generation",
    "hostId"
  ],
  "title": "InterceptProps",
  "type": "object"
}
