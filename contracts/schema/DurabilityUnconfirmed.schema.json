{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied": {
      "const": true,
      "type": "boolean"
    },
    "error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "const": "durability_unconfirmed",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "required": [
    "error",
    "applied"
  ],
  "title": "DurabilityUnconfirmed",
  "type": "object"
}
