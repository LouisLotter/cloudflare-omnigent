                          },
                          "findings": {
                            "maximum": 9007199254740991,
                            "minimum": 0,
                            "type": "integer"
                          },
                          "incomplete": {
                            "maximum": 9007199254740991,
                            "minimum": 0,
                            "type": "integer"
