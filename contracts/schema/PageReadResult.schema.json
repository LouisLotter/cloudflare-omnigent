                        },
                        "codex": {
                          "enum": [
                            "starting",
                            "awaiting_user",
                            "completing",
                            "done",
                            "failed",
                            "expired",
                            "cancelled",
                            "superseded",
                            "none"
                          ],
                          "type": "string"
