                              "type": "null"
                            }
                          ]
                        },
                        "codex": {
                          "anyOf": [
                            {
                              "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,6}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "gh": {
                          "anyOf": [
                            {
                              "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,6}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
