              "type": "object"
            }
          },
          "required": [
            "action",
            "outcome",
            "view"
          ],
          "type": "object"
        },
        {
          "additionalProperties": {},
          "properties": {
            "action": {
              "const": "sign_in_status",
              "type": "string"
            },
            "outcome": {
