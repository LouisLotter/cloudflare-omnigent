                "state": {
                  "enum": [
                    "starting",
                    "awaiting_user",
                    "completing",
                    "done",
                    "failed",
                    "expired",
                    "cancelled",
                    "superseded",
                    "none"
                  ],
                  "type": "string"
                },
                "url": {
                  "maxLength": 2048,
                  "minLength": 9,
                  "pattern": "^https:\\/\\/[A-Za-z0-9\\-._~:/?#@!$&()*+,;=%]+$",
                  "type": "string"
                },
                "userCode": {
                  "pattern": "^[A-Z0-9]{4,12}(?:-[A-Z0-9]{4,12}){0,3}$",
                  "type": "string"
                }
              },
              "required": [
                "service",
                "attempt",
                "state"
