{
  "name": "cloudflare-omnigent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/staging",
    "test": "pnpm -r --if-present test",
    "contracts:export": "pnpm --filter @cfo/contracts export-schema",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "test:staging": "vitest run scripts/staging",
    "stg": "node scripts/staging/stg.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
